{
	"name": "@strapi-community/dockerize",
	"description": "Create Docker and Docker-compose files for your Strapi project with ease",
	"version": "2.0.0-beta.1",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=18.0.0"
	},
	"bin": {
		"strapi-dockerize": "./dist/cli.js"
	},
	"files": [
		"dist",
		"templates"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"clean": "rimraf dist",
		"format": "prettier --write \"src/**/*.{ts,tsx,md}\"",
		"lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
		"test": "vitest",
		"test:watch": "vitest watch",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"typecheck": "tsc --noEmit",
		"prepare": "husky install",
		"prepublishOnly": "npm run build",
		"release": "semantic-release",
		"dev:cli": "tsx src/cli.tsx",
		"link": "npm link",
		"unlink": "npm unlink",
		"dev:watch": "tsx watch src/cli.tsx"
	},
	"dependencies": {
		"@inkjs/ui": "^1.0.0",
		"chalk": "^5.3.0",
		"commander": "^11.1.0",
		"conf": "^12.0.0",
		"env-paths": "^3.0.0",
		"execa": "^8.0.1",
		"fs-extra": "^11.2.0",
		"ink": "^4.4.1",
		"ink-big-text": "^2.0.0",
		"ink-gradient": "^3.0.0",
		"ink-select-input": "^5.0.0",
		"ink-spinner": "^5.0.0",
		"ink-text-input": "^5.0.1",
		"liquidjs": "^10.10.1",
		"node-fetch": "^3.3.2",
		"ora": "^8.0.1",
		"react": "^18.2.0",
		"zod": "^3.22.4"
	},
	"devDependencies": {
		"@commitlint/cli": "^18.4.3",
		"@commitlint/config-conventional": "^18.4.3",
		"@types/dotenv": "^6.1.1",
		"@types/fs-extra": "^11.0.4",
		"@types/ink-big-text": "^1.2.4",
		"@types/ink-gradient": "^2.0.4",
		"@types/node": "^20.10.5",
		"@types/react": "^18.2.45",
		"@typescript-eslint/eslint-plugin": "^6.15.0",
		"@typescript-eslint/parser": "^6.15.0",
		"@vitest/coverage-v8": "^1.1.0",
		"@vitest/ui": "^1.1.0",
		"dotenv": "^16.4.7",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-prettier": "^5.1.0",
		"eslint-plugin-react": "^7.33.2",
		"eslint-plugin-react-hooks": "^4.6.0",
		"husky": "^8.0.3",
		"ink-testing-library": "^3.0.0",
		"lint-staged": "^15.2.0",
		"prettier": "^3.1.1",
		"rimraf": "^5.0.5",
		"semantic-release": "^22.0.12",
		"strip-ansi": "^7.1.0",
		"tsup": "^8.0.1",
		"tsx": "^4.7.0",
		"typescript": "^5.3.3",
		"vitest": "^1.1.0"
	},
	"peerDependencies": {
		"react": "^18.2.0"
	},
	"keywords": [
		"strapi",
		"docker",
		"docker-compose",
		"cli",
		"typescript",
		"strapi-tool",
		"strapi-community"
	],
	"author": "Simen Daehlin <simen.dehlin@gmail.com> (https://dehlin.dev)",
	"repository": {
		"type": "git",
		"url": "https://github.com/strapi-community/strapi-tool-dockerize.git"
	},
	"bugs": {
		"url": "https://github.com/strapi-community/strapi-tool-dockerize/issues"
	},
	"homepage": "https://github.com/strapi-community/strapi-tool-dockerize#readme",
	"lint-staged": {
		"*.{ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		]
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	}
}
