services:
  strapi:
    container_name: strapi
    build: .
    image: strapi:latest
    restart: unless-stopped
    env_file: .env
    environment:
      DATABASE_CLIENT: sqlite
      DATABASE_FILENAME: {{ database.filename }}
      JWT_SECRET: ${JWT_SECRET}
      ADMIN_JWT_SECRET: ${ADMIN_JWT_SECRET}
      APP_KEYS: ${APP_KEYS}
      NODE_ENV: {{ environment }}
    volumes:
      - ./config:/opt/app/config
      - ./src:/opt/app/src
      {% if packageManager == 'yarn' %}
      - ./package.json:/opt/package.json
      - ./yarn.lock:/opt/yarn.lock
      {% elsif packageManager == 'pnpm' %}
      - ./package.json:/opt/package.json
      - ./pnpm-lock.yaml:/opt/pnpm-lock.yaml
      {% else %}
      - ./package.json:/opt/package.json
      - ./package-lock.json:/opt/package-lock.json
      {% endif %}
      - ./.env:/opt/app/.env
      - ./public/uploads:/opt/app/public/uploads
      # SQLite database directory bind mount for data persistence (matches Strapi defaults)
      - ./.tmp:/opt/app/.tmp
    ports:
      - "1337:1337"
    networks:
      - strapi

volumes:
  strapi-sqlite-data:

networks:
  strapi:
    name: Strapi
    driver: bridge 