services:
  {{ projectName }}:
    build:
      context: .
      dockerfile: {% if environment == "production" %}Dockerfile.prod{% else %}Dockerfile{% endif %}

    init: true
    restart: unless-stopped
    env_file: .env
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    ports:
      - "{{ strapiPort }}:{{ strapiPort }}"
    volumes:
{%- if environment != "production" %}
      - ./config:/opt/app/config
      - ./src:/opt/app/src
      - ./package.json:/opt/app/package.json
{%- if lockFile %}
      - ./{{ lockFile }}:/opt/app/{{ lockFile }}
{%- endif %}
{%- endif %}
      - strapi-uploads:/opt/app/public/uploads
{%- if databaseClient == "sqlite" %}
      - strapi-data:/opt/app/.tmp
{%- endif %}
{%- if databaseClient != "sqlite" %}
    depends_on:
      {{ projectName }}-db:
        condition: service_healthy
    networks:
      - {{ projectName }}-network
{%- endif %}
{%- if hasSecrets %}
    secrets:
{%- for secret in serviceSecrets %}
      - {{ secret }}
{%- endfor %}
{%- endif %}
    deploy:
      resources:
        limits:
          memory: {{ memoryLimit }}
          cpus: "{{ cpuLimit }}"
{%- if databaseClient != "sqlite" %}

  {{ projectName }}-db:
    image: {{ dbImage }}
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    environment:
{%- for entry in dbEnvironment %}
      {{ entry.key }}: "{{ entry.value }}"
{%- endfor %}
    ports:
{%- for port in dbPorts %}
      - "{{ port }}"
{%- endfor %}
    volumes:
{%- for volume in dbVolumes %}
      - {{ volume }}
{%- endfor %}
    healthcheck:
{%- for line in dbHealthTest %}
      {{ line }}
{%- endfor %}
      interval: {{ dbHealthInterval }}
      timeout: {{ dbHealthTimeout }}
      retries: {{ dbHealthRetries }}
{%- if dbHealthStartPeriod %}
      start_period: {{ dbHealthStartPeriod }}
{%- endif %}
{%- if hasSecrets %}
    secrets:
{%- for secret in serviceSecrets %}
      - {{ secret }}
{%- endfor %}
{%- endif %}
    networks:
      - {{ projectName }}-network
    deploy:
      resources:
        limits:
          memory: {{ dbMemoryLimit }}
          cpus: "{{ dbCpuLimit }}"
{%- endif %}
{%- if useAdminer and databaseClient != "sqlite" %}

  {{ projectName }}-adminer:
    image: {{ adminerImage }}
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    ports:
      - "{{ adminerPort }}:8080"
    depends_on:
      {{ projectName }}-db:
        condition: service_healthy
    networks:
      - {{ projectName }}-network
{%- endif %}
{%- if useBackups and databaseClient != "sqlite" and environment == "production" %}

  {{ projectName }}-backup:
    image: {{ backupImage }}
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    depends_on:
      {{ projectName }}-db:
        condition: service_healthy
    environment:
{%- if databaseClient == "postgres" %}
      POSTGRES_HOST: {{ projectName }}-db
      POSTGRES_DB: ${DATABASE_NAME}
      POSTGRES_USER: ${DATABASE_USERNAME}
      POSTGRES_PASSWORD: ${DATABASE_PASSWORD}
      SCHEDULE: {{ backupSchedule }}
      BACKUP_KEEP_DAYS: {{ backupRetentionDays }}
{%- else %}
      DB_SERVER: {{ projectName }}-db
      DB_USER: ${DATABASE_USERNAME}
      DB_PASS: ${DATABASE_PASSWORD}
      DB_NAMES: ${DATABASE_NAME}
      DB_DUMP_CRON: {{ backupSchedule }}
      RETENTION: {{ backupRetentionDays }}d
{%- endif %}
    volumes:
      - {{ projectName }}-backups:/backups
    networks:
      - {{ projectName }}-network
{%- endif %}

volumes:
  strapi-uploads:
{%- if databaseClient == "sqlite" %}
  strapi-data:
{%- endif %}
{%- if databaseClient != "sqlite" %}
{%- for volume in namedVolumes %}
  {{ volume }}:
{%- endfor %}
{%- endif %}
{%- if useBackups and databaseClient != "sqlite" and environment == "production" %}
  {{ projectName }}-backups:
{%- endif %}

{%- if databaseClient != "sqlite" %}

networks:
  {{ projectName }}-network:
    driver: bridge
{%- endif %}
{%- if hasSecrets %}

secrets:
{%- for secret in secrets %}
  {{ secret.name }}:
    file: {{ secret.file }}
{%- endfor %}
{%- endif %}
