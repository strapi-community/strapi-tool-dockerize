services:
  {{ projectName }}:
    build:
      context: .
      dockerfile: {% if environment == "production" %}Dockerfile.prod{% else %}Dockerfile{% endif %}

    init: true
    restart: unless-stopped
    env_file: .env
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    ports:
      - "{{ strapiPort }}:{{ strapiPort }}"
    volumes:
{% if environment != "production" %}
      - ./config:/opt/app/config
      - ./src:/opt/app/src
      - ./package.json:/opt/app/package.json
{% if lockFile %}
      - ./{{ lockFile }}:/opt/app/{{ lockFile }}
{% endif %}
{% endif %}
      - strapi-uploads:/opt/app/public/uploads
{% if databaseClient == "sqlite" %}
      - strapi-data:/opt/app/.tmp
{% endif %}
{% if databaseClient != "sqlite" %}
    depends_on:
      {{ projectName }}-db:
        condition: service_healthy
{% endif %}
    networks:
      - {{ projectName }}-network
{% if databaseClient != "sqlite" %}

  {{ projectName }}-db:
    image: {{ dbImage }}
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    environment:
{% for entry in dbEnvironment %}
      {{ entry.key }}: "{{ entry.value }}"
{% endfor %}
    ports:
{% for port in dbPorts %}
      - "{{ port }}"
{% endfor %}
    volumes:
{% for volume in dbVolumes %}
      - {{ volume }}
{% endfor %}
    healthcheck:
{% for line in dbHealthTest %}
      {{ line }}
{% endfor %}
      interval: {{ dbHealthInterval }}
      timeout: {{ dbHealthTimeout }}
      retries: {{ dbHealthRetries }}
{% if dbHealthStartPeriod %}
      start_period: {{ dbHealthStartPeriod }}
{% endif %}
{% if environment == "production" %}
    secrets:
      - db_password
{% endif %}
    networks:
      - {{ projectName }}-network
{% endif %}
{% if useAdminer and databaseClient != "sqlite" %}

  {{ projectName }}-adminer:
    image: {{ adminerImage }}
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    ports:
      - "{{ adminerPort }}:8080"
    depends_on:
      {{ projectName }}-db:
        condition: service_healthy
    networks:
      - {{ projectName }}-network
{% endif %}

volumes:
  strapi-uploads:
{% if databaseClient == "sqlite" %}
  strapi-data:
{% endif %}
{% if databaseClient != "sqlite" %}
{% for volume in namedVolumes %}
  {{ volume }}:
{% endfor %}
{% endif %}

networks:
  {{ projectName }}-network:
    driver: bridge
{% if environment == "production" and databaseClient != "sqlite" %}

secrets:
  db_password:
    file: ./secrets/db_password.txt
{% endif %}
