# Database
DATABASE_CLIENT={{ database.client }}
DATABASE_HOST={{ database.serviceName }}
DATABASE_PORT={{ database.port }}
DATABASE_NAME={{ database.name }}
DATABASE_USERNAME={{ database.user }}
DATABASE_PASSWORD={{ database.password }}

# Secrets (Generated automatically - keep these secure!)
JWT_SECRET={{ secrets.jwt }}
ADMIN_JWT_SECRET={{ secrets.adminJwt }}
APP_KEYS={{ secrets.appKeys }}

# Environment
NODE_ENV={{ environment }}

# Optional: Strapi Server URL (uncomment for production)
# STRAPI_URL=https://api.example.com 