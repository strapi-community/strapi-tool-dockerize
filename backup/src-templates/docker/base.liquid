# Base stage for all builds
FROM node:{{nodeVersion}}-alpine as base

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apk add --no-cache \
    build-base \
    gcc \
    autoconf \
    automake \
    zlib-dev \
    libpng-dev \
    vips-dev \
    git \
    python3

# Environment setup
ENV NODE_ENV={{environment}} \
    PATH=/app/node_modules/.bin:$PATH

# Copy package files
COPY package*.json ./

# Install dependencies
RUN {% if production %}npm ci --only=production{% else %}npm install{% endif %}

{% if buildArgs %}
# Build arguments
{% for arg in buildArgs %}
ARG {{arg.key}}={{arg.value}}
{% endfor %}
{% endif %}

{% if volumes %}
# Volumes
{% for volume in volumes %}
VOLUME {{volume}}
{% endfor %}
{% endif %}

{% if ports %}
# Expose ports
{% for port in ports %}
EXPOSE {{port}}
{% endfor %}
{% endif %} 